{
  "schema_version": 1,
  "id": "sound-sample",
  "title": "Sound Channel C Sample",
  "version": "0.1.0-dev",
  "summary": "Starts and stops one MN1271 channel C tone around a bounded busy wait.",
  "license": "BSD-3-Clause",
  "distribution": {"format": "cjr", "file": "sound-sample.cjr"},
  "load": {"method": "cjr_loader", "address": "0x1000"},
  "run": {"method": "basic_usr", "command": "A=USR($1000)", "entry_address": "0x1000", "return": "RTS"},
  "verification": {"emulator": "not_run", "hardware": "not_run"}
}

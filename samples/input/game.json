{
  "schema_version": 1,
  "id": "input-sample",
  "title": "Direct Key Input Sample",
  "version": "0.1.0-dev",
  "summary": "Polls the JR-200 direct key latch with a bounded timeout.",
  "license": "BSD-3-Clause",
  "distribution": {"format": "cjr", "file": "input-sample.cjr"},
  "load": {"method": "cjr_loader", "address": "0x1000"},
  "run": {"method": "basic_usr", "command": "A=USR($1000)", "entry_address": "0x1000", "return": "RTS"},
  "verification": {"emulator": "not_run", "hardware": "not_run"}
}

{
  "schema_version": 1,
  "id": "port-fixture-sample",
  "title": "Port SDK Fixture",
  "version": "0.1.0-dev",
  "summary": "Two-stage 3x3 cross-toggle fixture for the JR100dev port SDK modules.",
  "license": "BSD-3-Clause",
  "distribution": {"format": "cjr", "file": "port-fixture-sample.cjr"},
  "load": {"method": "cjr_loader", "address": "0x1000"},
  "run": {"method": "basic_usr", "command": "A=USR($1000)", "entry_address": "0x1000", "return": "RTS"},
  "verification": {"emulator": "not_run", "hardware": "not_run"}
}

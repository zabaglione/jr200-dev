{
  "schema_version": 1,
  "id": "chord-sample",
  "title": "Three-Voice Chord Sample",
  "version": "0.1.0-dev",
  "summary": "Plays a looping three-voice pattern on channels F, D and C with sdk/audio.inc.",
  "license": "BSD-3-Clause",
  "distribution": {"format": "cjr", "file": "chord-sample.cjr"},
  "load": {"method": "cjr_loader", "address": "0x1000"},
  "run": {"method": "basic_usr", "command": "A=USR($1000)", "entry_address": "0x1000", "return": "RTS"},
  "verification": {"emulator": "not_run", "hardware": "not_run"}
}

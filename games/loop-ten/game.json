{
  "schema_version": 2,
  "id": "loop-ten",
  "title": "LOOP TEN",
  "version": "0.1.0-dev",
  "summary": "Light twelve seals in a ten-second time loop; lit seals and opened doors survive every rewind.",
  "genre": "exploration",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "loop-ten.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "draft",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "not-published"
  }
}

{
  "schema_version": 2,
  "id": "circuit-works",
  "title": "CIRCUIT WORKS",
  "version": "0.1.0",
  "summary": "Set three chained AND/OR/XOR gates so all eight inputs match the wanted output across 22 puzzles.",
  "genre": "tactics",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "circuit-works.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "verified",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "published"
  }
}

{
  "schema_version": 2,
  "id": "dice-relic",
  "title": "DICE RELIC",
  "version": "0.1.0-dev",
  "summary": "Roll three dice and assign each to attack, guard or heal through nine guardians, forging stronger faces with the spoils.",
  "genre": "tabletop",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "dice-relic.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "draft",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "not-published"
  }
}

{
  "schema_version": 2,
  "id": "relic-dive",
  "title": "RELIC DIVE",
  "version": "0.1.1-dev",
  "summary": "Descend a generated dungeon turn by turn and recover the relic on the deepest floor.",
  "genre": "exploration",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "relic-dive.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "candidate",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "not-published"
  }
}

{
  "schema_version": 2,
  "id": "lumen-cross",
  "title": "LUMEN CROSS",
  "version": "0.1.0-dev",
  "summary": "Flip a five-light cross on a 5x5 panel and switch every light off across 18 stages.",
  "genre": "puzzle",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "lumen-cross.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "draft",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "not-published"
  }
}

{
  "schema_version": 2,
  "id": "brick-pulse",
  "title": "BRICK PULSE",
  "version": "0.1.1",
  "summary": "Twelve brick arenas with armored bricks, drones, bombs and W/S/G pickups; three balls per arena.",
  "genre": "action",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "brick-pulse.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "verified",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "published"
  }
}

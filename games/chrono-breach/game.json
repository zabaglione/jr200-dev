{
  "schema_version": 2,
  "id": "chrono-breach",
  "title": "CHRONO BREACH",
  "version": "0.1.0-dev",
  "summary": "Time moves only when you do: read the guards' firing lines, strike or shoot them down and reach the exit across twenty sectors.",
  "genre": "tactics",
  "license": "MIT",
  "distribution": {
    "format": "cjr",
    "file": "chrono-breach.cjr"
  },
  "load": {
    "method": "cjr_loader",
    "address": "0x1000"
  },
  "run": {
    "method": "basic_usr",
    "command": "A=USR($1000)",
    "entry_address": "0x1000",
    "return": "RTS"
  },
  "verification": {
    "emulator": "passed",
    "hardware": "not_run"
  },
  "release": {
    "status": "draft",
    "sdk_contract": 1,
    "runner_contract": 1,
    "minimum_runner_version": "0.3.0",
    "wav": "not-required",
    "publication": "not-published"
  }
}
